    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nif (!body.pdfcoKey || !body.pdfcoKey.includes('@')) throw new Error('Invalid PDF.co key');\nconst filled = body.filledDocs || [];\nconst drive = body.driveFileIds || [];\nif (filled.length === 0 && drive.length === 0) throw new Error('No documents to merge');\nreturn [{ json: body }];"
      },
      "id": "ca5b0f5f-c4f6-4732-955f-9920947a4492",
      "name": "Validate Merge Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Validate Merge Input').first().json;\nconst tasks = [];\nlet fallback = 0;\nfor (const doc of body.filledDocs || []) {\n  const m = (doc.viewLink || '').match(/\\/d\\/([a-zA-Z0-9_-]+)/);\n  if (!m) continue;\n  tasks.push({\n    type: 'filled',\n    fileId: m[1],\n    docKey: doc.docKey,\n    exportUrl: 'https://www.googleapis.com/drive/v3/files/' + m[1] + '/export?mimeType=application%2Fpdf',\n    presignUrl: 'https://api.pdf.co/v1/file/upload/get-presigned-url?contenttype=application/pdf&name=' + encodeURIComponent(doc.docKey + '.pdf'),\n    outputName: body.outputName,\n    pdfcoKey: body.pdfcoKey,\n    orderIndex: typeof doc.orderIndex === 'number' ? doc.orderIndex : fallback++\n  });\n}\nfor (const f of body.driveFileIds || []) {\n  if (!f.fileId) continue;\n  tasks.push({\n    type: 'drive',\n    fileId: f.fileId,\n    docKey: f.docKey,\n    permUrl: 'https://www.googleapis.com/drive/v3/files/' + f.fileId + '/permissions',\n    publicUrl: 'https://drive.usercontent.google.com/download?id=' + f.fileId + '&export=download&confirm=t',\n    outputName: body.outputName,\n    pdfcoKey: body.pdfcoKey,\n    orderIndex: typeof f.orderIndex === 'number' ? f.orderIndex : fallback++\n  });\n}\nreturn tasks.map(t => ({ json: t }));"
      },
