    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const orig = $('Build Tasks').itemMatching($itemIndex).json;\nconst perm = $input.item.json;\nreturn {\n  json: {\n    type: 'drive',\n    docKey: orig.docKey,\n    fileId: orig.fileId,\n    permissionId: perm.id,\n    url: orig.publicUrl,\n    orderIndex: orig.orderIndex,\n    outputName: orig.outputName,\n    pdfcoKey: orig.pdfcoKey\n  }\n};"
      },
      "id": "763c7bb6-67a6-44b1-9e53-58e8a5eb3812",
      "name": "Mark Drive Done",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nitems.sort((a,b) => a.orderIndex - b.orderIndex);\nreturn [{ json: {\n  urls: items.map(i => i.url),\n  items: items.map(i => ({ docKey: i.docKey, url: i.url, type: i.type })),\n  permissionData: items.filter(i => i.type === 'drive' && i.permissionId).map(i => ({ fileId: i.fileId, permissionId: i.permissionId })),\n  outputName: items[0].outputName,\n  pdfcoKey: items[0].pdfcoKey,\n  fileCount: items.length\n} }];"
      },
      "id": "b5019638-24ac-4165-b904-50abb8db6d76",
      "name": "Aggregate URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Validate Merge Input').first().json;\nconst agg = $input.first().json;\nconst items = body.indexItems || [];\nconst roman = (n) => { const map = [['M',1000],['CM',900],['D',500],['CD',400],['C',100],['XC',90],['L',50],['XL',40],['X',10],['IX',9],['V',5],['IV',4],['I',1]]; let r='',x=n; for (const [s,v] of map) while (x>=v){r+=s;x-=v;} return r; };\nconst esc = (s) => String(s||'').replace(/[<>&]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));\nconst rows = items.map((it,i) => '<tr><td class=\"num\">'+roman(i+1)+'.</td><td class=\"name\">'+esc(it.label)+'</td></tr>').join('\\n');\nconst html = '<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>@import url(\"https://fonts.googleapis.com/css2?family=Playfair+Display&family=Roboto+Flex:wght@300;400;500&display=swap\");@page { size: A4; margin: 0; }html, body { margin: 0; padding: 0; }body { font-family: \"Roboto Flex\", Arial, sans-serif; color: #1C1C1C; padding: 90px 90px; position: relative; }h1 { font-family: \"Playfair Display\", Georgia, serif; color: #7C0000; text-align: center; font-size: 36pt; font-weight: 400; margin: 40px 0 70px 0; letter-spacing: 0.04em; }table { margin: 0; border-collapse: collapse; }td { padding: 11px 0; vertical-align: top; }td.num { width: 50px; padding-left: 0; font-size: 11pt; font-weight: 400; }td.name { font-size: 11pt; font-weight: 500; letter-spacing: 0.04em; padding-left: 20px; padding-right: 30px; }</style></head><body><h1>INDEX</h1><table>'+rows+'</table></body></html>';\nreturn [{ json: { skip: items.length === 0, html, pdfcoKey: agg.pdfcoKey, outputName: agg.outputName, urls: agg.urls, items: agg.items, permissionData: agg.permissionData, fileCount: agg.fileCount } }];"
      },
      "id": "8baeb4f6-d8b0-4ef1-b7e0-d06e082a3311",
      "name": "Build Index HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.pdf.co/v1/pdf/convert/from/html",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.pdfcoKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { html: $json.html, name: ($json.outputName || \"submittal\") + \"_index.pdf\", async: false, margins: \"20mm\", paperSize: \"A4\", printBackground: true } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "id": "0566142a-5cfa-4fcc-9a67-4b6fc9626fae",
      "name": "Generate Index PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2688,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const bh = $('Build Index HTML').first().json;\nconst httpRes = $input.first().json;\nconst indexUrl = httpRes && httpRes.url ? httpRes.url : null;\nif (bh.skip || !indexUrl) {\n  return [{ json: { urls: bh.urls, permissionData: bh.permissionData, outputName: bh.outputName, pdfcoKey: bh.pdfcoKey, fileCount: bh.fileCount, indexUrl: null }}];\n}\nconst items = bh.items || [];\nconst coverIdx = items.findIndex(i => i.docKey === 'cover');\nconst insertAt = coverIdx >= 0 ? coverIdx + 1 : 0;\nconst urls = [...bh.urls];\nurls.splice(insertAt, 0, indexUrl);\nreturn [{ json: { urls, permissionData: bh.permissionData, outputName: bh.outputName, pdfcoKey: bh.pdfcoKey, fileCount: bh.fileCount + 1, indexUrl, insertedAt: insertAt }}];"
      },
