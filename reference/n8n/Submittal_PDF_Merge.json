    {
      "parameters": {
        "jsCode": "const res = $input.first().json;\nif (!res.jobId) throw new Error('No jobId returned from PDF.co');\nconst pre = $('Prepend Index').first().json;\nreturn [{ json: { success: true, jobId: res.jobId, mergedUrl: res.url, pdfcoKey: pre.pdfcoKey, outputName: pre.outputName, fileCount: pre.fileCount, permissionData: pre.permissionData, indexUrl: pre.indexUrl } }];"
