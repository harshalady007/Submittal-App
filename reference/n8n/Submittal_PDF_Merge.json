    {
      "parameters": {
        "jsCode": "const httpRes = $input.first().json;\nconst inputBody = $('Validate Fetch').first().json;\nconst body = httpRes.body || {};\nif (body.status === 'failed' || body.status === 'aborted') {\n  return [{ json: { ready: false, error: true, message: body.message || 'Job failed', status: body.status } }];\n}\nif (body.status === 'success') {\n  return [{ json: { ready: true, mergedUrl: inputBody.mergedUrl, outputName: inputBody.outputName, fileCount: inputBody.fileCount } }];\n}\nreturn [{ json: { ready: false, status: body.status || 'unknown' } }];"
