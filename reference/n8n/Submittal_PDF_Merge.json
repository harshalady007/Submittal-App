    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const orig = $('Build Tasks').itemMatching($itemIndex).json;\nconst presigned = $('Get Presigned URL').itemMatching($itemIndex).json;\nreturn {\n  json: {\n    type: 'filled',\n    docKey: orig.docKey,\n    url: presigned.url,\n    orderIndex: orig.orderIndex,\n    outputName: orig.outputName,\n    pdfcoKey: orig.pdfcoKey\n  }\n};"
